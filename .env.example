NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_access_token
# Nom du template approuvé (laisser vide = message texte, dev uniquement)
WHATSAPP_OTP_TEMPLATE_NAME=
# Webhook ENTRANT (réponses clients → auto-confirm). GET handshake :
#   token de vérification du webhook WhatsApp. Optionnel — retombe sur META_VERIFY_TOKEN.
WHATSAPP_VERIFY_TOKEN=
# 360dialog (canal réel V1, live ~28 juin) : secret partagé du webhook entrant.
#   Tant que vide, seul le chemin Meta signé (X-Hub-Signature-256) est accepté.
D360_WEBHOOK_SECRET=

# Yalidine credentials : configurés par chaque vendeur dans Paramètres (stockés en base)

# QR Smart Delivery — OBLIGATOIRE en prod
# Générer : openssl rand -hex 32
# Avant deploy Vercel : ajouter QR_SIGNING_SECRET dans les env vars (32+ chars random)
QR_SIGNING_SECRET=replace_me_with_long_random_string

# Meta Lead Ads — App ID: 1958408901714613
# META_APP_SECRET : dans le dashboard Facebook App → Paramètres → Basique
# META_VERIFY_TOKEN : chaîne random 32+ chars — à copier aussi dans Meta webhook config
# Générer : openssl rand -hex 32
META_APP_ID=1958408901714613
META_APP_SECRET=replace_with_meta_app_secret
META_VERIFY_TOKEN=replace_with_random_32_char_string
META_REDIRECT_URI=https://golivra.app/api/meta/auth/callback

# Buyer-score anti-énumération (LOT12 phase 1 — observation)
# BUYER_SCORE_HASH_SALT : clé secrète HMAC pour hasher le numéro dans le log d'audit.
#   OBLIGATOIRE pour que l'observation tourne (absente → log ignoré, jamais de numéro en clair).
#   Générer : openssl rand -hex 32. JAMAIS commité, JAMAIS en dur.
BUYER_SCORE_HASH_SALT=replace_with_random_32_char_string
# Seuil d'alerte volume (consultations/24 h glissantes par vendeur). Défaut 150 si vide.
BUYER_SCORE_ALERT_THRESHOLD=150

# [N12-4] order_otp_code v2 — repli MSG 2 via template Meta AUTHENTICATION (copy-code).
#   AUTH_OTP_TEMPLATE_READY : "true" = utiliser le template Auth hors fenêtre 24h ; sinon (défaut)
#     comportement actuel (texte libre in-window, repli classique). Passer à "true" UNIQUEMENT
#     une fois le template Authentication APPROUVÉ côté Meta.
AUTH_OTP_TEMPLATE_READY=false
#   Nom + langue du template Auth soumis (défaut order_otp_code / fr).
WHATSAPP_OTP_AUTH_TEMPLATE_NAME=order_otp_code
WHATSAPP_OTP_AUTH_TEMPLATE_LANG=fr

# [N32W.1] MSG 1 variante D4 « prix séparé » (produit + frais de livraison sur 2 lignes).
#   MSG1_SPLIT_TEMPLATE_READY : "true" = envoyer order_confirmation_request_split (5 var) quand
#     la commande a des frais de livraison > 0 ; sinon (défaut) template 4-var actuel (total seul).
#     Passer à "true" UNIQUEMENT une fois order_confirmation_request_split APPROUVÉ côté Meta.
MSG1_SPLIT_TEMPLATE_READY=false

# [N36W] Rattrapage de vente (winback) — envoi de l'offre order_winback_offer.
#   WINBACK_SEND_READY : "true" = sendWinbackOffer() peut envoyer ; sinon (défaut absent) il no-op.
#     ⚠️ Même à "true", AUCUN déclencheur automatique n'est branché (la fonction existe, rien ne l'appelle
#     encore — le déclencheur sera un lot ultérieur). Nécessite migration 045 appliquée (prepared_responses).
WINBACK_SEND_READY=false

# Chargily Pay v2 — URL de l'API par env (défaut = TEST si absente).
#   Test : https://pay.chargily.net/test/api/v2  (défaut, safe en local)
#   Live : https://pay.chargily.net/api/v2       (prod — passer cette valeur en env Vercel)
CHARGILY_API_BASE=https://pay.chargily.net/test/api/v2
