*.tsbuildinfo
next-env.d.ts
.env*.local
.env.local

# Dev artifacts
.archive/
LIVRA_Section*.html
design_handoff_*/
.claude/
CLAUDE.md.backup-*

# Rapport de travail CC (écrasé à chaque rendu, local-only)
